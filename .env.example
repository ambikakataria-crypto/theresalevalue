# Basic credential for the Cars24 vehicle-service RC lookup (registration
# number -> make/model/variant). Without it the "Auto-detect" button reports
# that lookup is unavailable; the manual path keeps working.
#
# PUBLIC_ is required for the browser to read it, which also means the value is
# inlined into the client bundle at build time. That is unavoidable while the
# site is statically hosted and the browser calls the API directly. Move the
# call behind a server route if this must stay private.
PUBLIC_C24_VEHICLE_AUTH="Basic <base64 of user:password>"

# Bearer token for the fgvge-pricing model server. Read only by
# /api/v1/fgvge-pricing-predict, which runs on the server, so this one has no
# PUBLIC_ prefix and never reaches the browser. Without it that route answers
# 503 and the depreciation curve falls back to its built-in segment benchmarks.
C24_MODELSERVE_TOKEN="<jwt>"
