---
const stats = [
  { value: '10M+', label: 'Vehicle inspections analysed' },
  { value: '4,200+', label: 'Make × model × year combinations tracked' },
  { value: 'Weekly', label: 'Data refresh cadence' },
  { value: 'Published', label: 'Methodology, open and auditable' },
];
---
<section class="bg-white border-y border-cream-200">
  <div class="container-tight py-8">
    <div class="grid grid-cols-2 md:grid-cols-4 gap-6">
      {stats.map(stat => (
        <div class="text-center md:text-left">
          <div class="font-data text-2xl md:text-3xl font-medium text-navy-900">{stat.value}</div>
          <div class="text-xs md:text-sm text-slate-soft mt-1">{stat.label}</div>
        </div>
      ))}
    </div>
  </div>
</section>
