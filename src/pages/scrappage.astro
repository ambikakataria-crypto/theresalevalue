---
import BaseLayout from '../layouts/BaseLayout.astro';
import ComingSoon from '../components/ComingSoon.astro';
---
<BaseLayout
  title="Vehicle Scrappage Value Estimator India: Coming Soon"
  description="What your old vehicle is worth at a Registered Vehicle Scrapping Facility under India's Vehicle Scrappage Policy. Coming 2026."
  noindex
>
  <ComingSoon
    icon="♻️"
    category="Scrappage Value"
    headline="What your old vehicle is worth at scrap."
    description="Under India's Vehicle Scrappage Policy, vehicles older than 15 years (petrol) or 10 years (diesel) qualify for scrappage, with GST rebates, road tax discounts, and OEM discounts on your next vehicle. We'll show you the full value equation."
    bullets={[
      'Fair scrap value from Registered Vehicle Scrapping Facilities (RVSFs)',
      'GST rebate + road tax discount + OEM discount stacking calculator',
      'Compare: scrap vs sell as-is vs restore-and-sell',
      'RVSF locator across India for nearest verified facilities',
    ]}
    eta="Q2 2027"
  />
</BaseLayout>
