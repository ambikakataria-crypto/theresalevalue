---
import BaseLayout from '../layouts/BaseLayout.astro';
import { changelog } from '../data/changelog';

const title = 'Changelog, TheResaleValue';
const description = 'Dated log of edits, data refreshes, and editorial changes on TheResaleValue. Updated weekly.';
---
<BaseLayout title={title} description={description} noindex={true}>
  <article class="py-12 md:py-16">
    <div class="container-tight max-w-3xl">
      <div class="text-xs uppercase tracking-widest text-slate-soft mb-3">
        <a href="/">Home</a> · Changelog
      </div>
      <h1 class="text-4xl md:text-5xl font-serif text-navy-900 mb-4 leading-tight">Changelog</h1>
      <p class="text-lg text-graphite leading-relaxed mb-10">
        What we changed on TheResaleValue and when. Data refreshes, editorial edits, new pages, corrections. Updated weekly, usually Fridays.
      </p>

      <ol class="space-y-8 border-l-2 border-cream-200 pl-6">
        {changelog.map((entry) => (
          <li>
            <div class="flex items-baseline gap-3 mb-2">
              <span class="font-data text-sm text-navy-900">{new Date(entry.date).toLocaleDateString('en-IN', { day: 'numeric', month: 'short', year: 'numeric' })}</span>
              <span class="text-xs uppercase tracking-widest text-slate-soft">{entry.editor}</span>
            </div>
            <ul class="space-y-2">
              {entry.items.map((item) => (
                <li class="text-base text-graphite leading-relaxed flex items-start gap-3">
                  <span class="text-signal-500 mt-1 flex-shrink-0">▸</span>
                  <span>{item}</span>
                </li>
              ))}
            </ul>
          </li>
        ))}
      </ol>

      <div class="card-institutional bg-cream-100 border border-cream-200 mt-12 text-sm text-graphite">
        <strong class="text-navy-900">Correction or missing edit?</strong> Write to <a href="mailto:editorial@theresalevalue.com" class="text-signal-600 hover:underline">editorial@theresalevalue.com</a>. We publish corrections in this feed with the original error and the fix.
      </div>
    </div>
  </article>
</BaseLayout>
