              <tr><td class="p-2 border border-cream-200">Maharashtra</td><td class="p-2 border border-cream-200">Up to 25%</td><td class="p-2 border border-cream-200">Full waiver</td></tr>
              <tr><td class="p-2 border border-cream-200">Karnataka</td><td class="p-2 border border-cream-200">Up to 25%</td><td class="p-2 border border-cream-200">Full waiver</td></tr>
