                <th class="text-left p-3 border-b border-cream-200 font-semibold text-navy-900">IRDAI-mandated depreciation</th>
              </tr>
            </thead>
            <tbody>
              <tr><td class="p-3 border-b border-cream-200">Not exceeding 6 months</td><td class="p-3 border-b border-cream-200">5%</td></tr>
              <tr><td class="p-3 border-b border-cream-200">6 months – 1 year</td><td class="p-3 border-b border-cream-200">15%</td></tr>
              <tr><td class="p-3 border-b border-cream-200">1–2 years</td><td class="p-3 border-b border-cream-200">20%</td></tr>
              <tr><td class="p-3 border-b border-cream-200">2–3 years</td><td class="p-3 border-b border-cream-200">30%</td></tr>
              <tr><td class="p-3 border-b border-cream-200">3–4 years</td><td class="p-3 border-b border-cream-200">40%</td></tr>
              <tr><td class="p-3">4–5 years</td><td class="p-3">50%</td></tr>
            </tbody>
          </table>
        </div>

