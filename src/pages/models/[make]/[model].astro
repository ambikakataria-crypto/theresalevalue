---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Byline from '../../../components/Byline.astro';
import swiftData from '../../../data/models/maruti-swift.json';

// Prototype: one model wired. To scale, import all /data/models/*.json and
// map them through getStaticPaths. Each JSON provides its own data slice.
export function getStaticPaths() {
  const models = [swiftData];
  return models.map((m) => ({
    params: { make: m.slug.make, model: m.slug.model },
    props: { data: m },
  }));
}

const { data } = Astro.props;

// Derived stats
const mids = data.permutations.map((p: any) => p.mid);
const rangeLow = Math.min(...mids);
const rangeHigh = Math.max(...mids);
const currentYear = 2026;

// Depreciation SVG geometry
const chartW = 600;
const chartH = 220;
const padL = 42;
const padR = 16;
const padT = 20;
const padB = 34;
const innerW = chartW - padL - padR;
const innerH = chartH - padT - padB;
const curve = data.retentionCurve;
const maxAge = Math.max(...curve.map((c: any) => c.ageYears));
const xFor = (age: number) => padL + (age / maxAge) * innerW;
const yFor = (pct: number) => padT + (1 - pct / 100) * innerH;
const linePath = curve
  .map((c: any, i: number) => `${i === 0 ? 'M' : 'L'} ${xFor(c.ageYears)} ${yFor(c.retentionPct)}`)
  .join(' ');
const segAvg5y = data.segmentAverageRetention['5year'];

// Meta
const title = `${data.make} ${data.model} resale value in India — ${currentYear} price range, depreciation & variants | TheResaleValue`;
const description = `${data.make} ${data.model} resale value in India: current market range ₹${rangeLow}–${rangeHigh} lakh across years, kilometres and fuel types. Depreciation curve, variant table and city-wise adjustments. Refreshed monthly.`;
---
<BaseLayout title={title} description={description}>

  <!-- 1. Institutional hero -->
  <section class="py-12 md:py-16 bg-cream-100 border-b border-cream-200">
    <div class="container-tight max-w-4xl">
      <div class="text-xs uppercase tracking-widest text-slate-soft mb-3">
        <a href="/">Home</a> · <a href="/valuation">Used car valuation</a> · {data.make} {data.model}
      </div>
      <div class="text-xs uppercase tracking-widest text-signal-600 font-semibold mb-3">{data.segment} · Resale report</div>
      <h1 class="text-4xl md:text-5xl font-serif text-navy-900 mb-4 leading-tight">
        {data.make} {data.model} resale value in India — {currentYear} market range
      </h1>
      <p class="text-lg text-graphite leading-relaxed mb-4">
        The {data.model} is India's highest-volume {data.bodyType.toLowerCase()} and one of the strongest resale performers in its segment. Below is the current fair-market range across year, kilometres, and fuel type, alongside the depreciation curve, variant-wise ex-showroom prices, and city-level adjustments.
      </p>
      <div class="flex flex-wrap items-center gap-4 text-sm text-slate-soft">
        <span>
          <span class="text-slate-soft">Current market range:</span>{' '}
          <span class="font-data text-navy-900">₹{rangeLow}L – ₹{rangeHigh}L</span>
        </span>
        <span class="text-cream-200">|</span>
        <span>Data refreshed {new Date(data.lastRefreshedISO).toLocaleDateString('en-IN', { day: 'numeric', month: 'short', year: 'numeric' })} · {data.refreshCadence}</span>
      </div>
    </div>
  </section>

  <article class="py-12 md:py-16">
    <div class="container-tight max-w-4xl">

      <Byline authorSlug={data.authorSlug} publishedDate="31 July 2026" readTime="12 min read" />

      <!-- 2. Interactive calculator -->
      <section aria-labelledby="calc-heading" class="card-institutional bg-white mb-12">
        <h2 id="calc-heading" class="text-2xl font-serif text-navy-900 mb-2">Check your {data.model}'s resale value</h2>
        <p class="text-sm text-slate-soft mb-5">Select year, kilometres and fuel type. Values are refreshed monthly from wholesale transaction data — no live API call. For a personalised report including RC and inspection scoring, use the <a href="/valuation" class="text-signal-600 hover:underline">full valuation tool</a>.</p>

        <div class="grid md:grid-cols-3 gap-4 mb-6">
          <label class="block text-sm">
            <span class="block text-xs uppercase tracking-widest text-slate-soft mb-1.5">Manufacturing year</span>
            <select id="calc-year" class="w-full border border-cream-200 rounded-md px-3 py-2 bg-white text-navy-900">
              {[2024, 2023, 2022, 2021, 2020].map(y => <option value={y}>{y}</option>)}
            </select>
          </label>
          <label class="block text-sm">
            <span class="block text-xs uppercase tracking-widest text-slate-soft mb-1.5">Kilometres driven</span>
            <select id="calc-km" class="w-full border border-cream-200 rounded-md px-3 py-2 bg-white text-navy-900">
              {['0-10k','10-25k','25-50k','50-75k','75k+'].map(k => <option value={k}>{k}</option>)}
            </select>
          </label>
          <label class="block text-sm">
            <span class="block text-xs uppercase tracking-widest text-slate-soft mb-1.5">Fuel type</span>
            <select id="calc-fuel" class="w-full border border-cream-200 rounded-md px-3 py-2 bg-white text-navy-900">
              <option value="Petrol">Petrol</option>
              <option value="CNG">CNG</option>
            </select>
          </label>
        </div>
        <label class="block text-sm mb-6">
          <span class="block text-xs uppercase tracking-widest text-slate-soft mb-1.5">City (optional)</span>
          <select id="calc-city" class="w-full md:w-1/2 border border-cream-200 rounded-md px-3 py-2 bg-white text-navy-900">
            <option value="0">All-India baseline</option>
            {data.cityVariance.map((c: any) => <option value={c.variancePct}>{c.city} ({c.variancePct >= 0 ? '+' : ''}{c.variancePct}%)</option>)}
          </select>
        </label>

        <div id="calc-result" class="border-t border-cream-200 pt-5">
          <div class="text-xs uppercase tracking-widest text-slate-soft mb-1">Fair-market resale range</div>
          <div class="flex items-baseline gap-3 mb-1">
            <span id="calc-mid" class="font-data text-4xl text-navy-900">₹6.40L</span>
            <span id="calc-band" class="text-sm text-slate-soft">Band: ₹5.95L – ₹6.85L</span>
          </div>
          <div id="calc-note" class="text-xs text-slate-soft mt-2">All-India baseline. Select a city for a city-adjusted range.</div>
        </div>
      </section>

      <!-- 3. Depreciation curve (inline SVG) -->
      <section aria-labelledby="dep-heading" class="mb-12">
        <h2 id="dep-heading" class="text-2xl font-serif text-navy-900 mb-3">{data.model} depreciation curve, year on year</h2>
        <p class="text-base text-graphite leading-relaxed mb-4">The {data.model} depreciates roughly 15% in year one, another 10% in year two, then approximately 7–8% per year through years three to five. Five-year retention lands at about {curve[4].retentionPct}%, compared with a B-segment hatchback average of about {segAvg5y}%.</p>
        <div class="card-institutional bg-white">
          <svg
            role="img"
            aria-labelledby="dep-svg-title dep-svg-desc"
            viewBox={`0 0 ${chartW} ${chartH}`}
            class="w-full h-auto"
            xmlns="http://www.w3.org/2000/svg"
          >
            <title id="dep-svg-title">{data.make} {data.model} value retention curve, years 1 to 5</title>
            <desc id="dep-svg-desc">Line chart showing {data.model} resale value retention percentage against age in years: year 1 {curve[0].retentionPct}%, year 2 {curve[1].retentionPct}%, year 3 {curve[2].retentionPct}%, year 4 {curve[3].retentionPct}%, year 5 {curve[4].retentionPct}%. Segment average at year 5 is {segAvg5y}%.</desc>

            {/* Y-axis gridlines and labels at 25/50/75/100 */}
            {[100, 75, 50, 25].map((pct) => (
              <>
                <line x1={padL} x2={chartW - padR} y1={yFor(pct)} y2={yFor(pct)} stroke="#E5DED3" stroke-dasharray="2 3" />
                <text x={padL - 8} y={yFor(pct) + 4} text-anchor="end" font-size="11" fill="#7A7268">{pct}%</text>
              </>
            ))}

            {/* Segment average reference line at year 5 */}
            <line x1={xFor(maxAge)} x2={xFor(maxAge)} y1={yFor(segAvg5y)} y2={yFor(curve[4].retentionPct)} stroke="#C4B79F" stroke-dasharray="3 3" />
            <text x={xFor(maxAge) - 6} y={yFor(segAvg5y) + 4} text-anchor="end" font-size="10" fill="#7A7268">seg avg {segAvg5y}%</text>

            {/* X-axis labels (years) */}
            {curve.map((c: any) => (
              <text x={xFor(c.ageYears)} y={chartH - padB + 18} text-anchor="middle" font-size="11" fill="#7A7268">Year {c.ageYears}</text>
            ))}

            {/* Retention line */}
            <path d={linePath} fill="none" stroke="#B8412C" stroke-width="2.5" />

            {/* Data points + inline labels */}
            {curve.map((c: any) => (
              <>
                <circle cx={xFor(c.ageYears)} cy={yFor(c.retentionPct)} r="4" fill="#B8412C" />
                <text x={xFor(c.ageYears)} y={yFor(c.retentionPct) - 10} text-anchor="middle" font-size="11" fill="#1B2A3F" font-weight="600">{c.retentionPct}%</text>
              </>
            ))}
          </svg>
          <div class="text-xs text-slate-soft mt-3">Chart values are aggregated across all variants and fuel types. Individual permutations vary — use the calculator above for a specific year/km/fuel combination.</div>
        </div>
      </section>

      <!-- 4. Variant × fuel table -->
      <section aria-labelledby="variant-heading" class="mb-12">
        <h2 id="variant-heading" class="text-2xl font-serif text-navy-900 mb-3">{data.model} variants and ex-showroom pricing ({currentYear})</h2>
        <p class="text-base text-graphite leading-relaxed mb-4">Current {data.model} variants and on-record ex-showroom prices, alongside the resale mid-point at three years for a car with 25,000–50,000 km on the odometer.</p>
        <div class="overflow-x-auto">
          <table class="w-full text-base border-collapse">
            <caption class="sr-only">{data.make} {data.model} variant-wise ex-showroom price and three-year resale mid-point.</caption>
            <thead class="bg-cream-100">
              <tr>
                <th class="text-left p-3 border border-cream-200 font-semibold text-navy-900">Variant</th>
                <th class="text-left p-3 border border-cream-200 font-semibold text-navy-900">Fuel</th>
                <th class="text-left p-3 border border-cream-200 font-semibold text-navy-900">Gearbox</th>
                <th class="text-right p-3 border border-cream-200 font-semibold text-navy-900">Ex-showroom (₹L)</th>
                <th class="text-right p-3 border border-cream-200 font-semibold text-navy-900">3-yr resale mid (₹L)</th>
                <th class="text-right p-3 border border-cream-200 font-semibold text-navy-900">Retention</th>
              </tr>
            </thead>
            <tbody>
              {data.variants.map((v: any) => {
                const perm3yr = data.permutations.find((p: any) => p.year === 2022 && p.kmBand === '25-50k' && p.fuel === v.fuel);
                const retention = perm3yr ? Math.round((perm3yr.mid / v.exShowroom) * 100) : null;
                return (
                  <tr>
                    <td class="p-3 border border-cream-200 text-navy-900 font-medium">{v.name}</td>
                    <td class="p-3 border border-cream-200">{v.fuel}</td>
                    <td class="p-3 border border-cream-200">{v.transmission}</td>
                    <td class="p-3 border border-cream-200 text-right font-data">{v.exShowroom.toFixed(2)}</td>
                    <td class="p-3 border border-cream-200 text-right font-data">{perm3yr ? perm3yr.mid.toFixed(2) : '—'}</td>
                    <td class="p-3 border border-cream-200 text-right font-data">{retention ? `${retention}%` : '—'}</td>
                  </tr>
                );
              })}
            </tbody>
          </table>
        </div>
        <div class="text-xs text-slate-soft mt-3">3-yr resale mid uses the 2022 model year at 25,000–50,000 km as reference. CNG variants share the same permutation grid but at CNG mid values, which run 3–5% above equivalent petrol on factory-fitted units.</div>
      </section>

      <!-- 5. City variance -->
      <section aria-labelledby="city-heading" class="mb-12">
        <h2 id="city-heading" class="text-2xl font-serif text-navy-900 mb-3">City-wise price variance</h2>
        <p class="text-base text-graphite leading-relaxed mb-4">Resale values for the {data.model} vary by 3–5 percentage points across Indian metros, driven by supply-demand tightness, RTO transfer friction, and CNG infrastructure. Numbers below are deltas against the all-India mid.</p>
        <div class="grid grid-cols-2 md:grid-cols-4 gap-3">
          {data.cityVariance.map((c: any) => (
            <div class="card-institutional bg-white text-center">
              <div class="text-xs uppercase tracking-widest text-slate-soft mb-1">{c.city}</div>
              <div class={`font-data text-2xl ${c.variancePct > 0 ? 'text-signal-600' : c.variancePct < 0 ? 'text-navy-900' : 'text-graphite'}`}>{c.variancePct > 0 ? '+' : ''}{c.variancePct}%</div>
              <div class="text-xs text-slate-soft mt-1">{c.note}</div>
            </div>
          ))}
        </div>
      </section>

      <!-- 6. Model context block (human-written / editable) -->
      <section aria-labelledby="ctx-heading" class="mb-12">
        <h2 id="ctx-heading" class="text-2xl font-serif text-navy-900 mb-3">What drives the {data.model}'s resale value</h2>
        <div class="prose-content space-y-4 text-base leading-relaxed text-graphite">
          {data.context.map((para: string) => <p>{para}</p>)}
        </div>
      </section>

      <!-- 7. Common issues to check at inspection -->
      <section aria-labelledby="issues-heading" class="mb-12">
        <h2 id="issues-heading" class="text-2xl font-serif text-navy-900 mb-3">What to check when buying a used {data.model}</h2>
        <ul class="space-y-3">
          {data.commonIssues.map((issue: string) => (
            <li class="flex items-start gap-3 text-base text-graphite leading-relaxed">
              <span class="text-signal-500 mt-1 flex-shrink-0">▸</span>
              <span>{issue}</span>
            </li>
          ))}
        </ul>
        {data.cngNote && (
          <div class="card-institutional bg-cream-100 border-l-4 border-signal-600 text-sm text-graphite mt-6">
            <strong class="text-navy-900">On CNG variants —</strong> {data.cngNote}
          </div>
        )}
      </section>

      <!-- 8. Methodology callout -->
      <section class="card-institutional bg-white border border-cream-200 mb-12 text-sm">
        <h2 class="text-lg font-serif text-navy-900 mb-2">How TheResaleValue calculates these numbers</h2>
        <p class="text-graphite leading-relaxed mb-2">Resale bands aggregate wholesale transaction prices across Indian metros, refreshed monthly. Age is calculated in whole years from the manufacturing date on the RC. Kilometre bands are self-reported and rounded to the nearest band. City adjustments apply an RTO-level multiplier on the all-India mid.</p>
        <p class="text-slate-soft"><strong class="text-navy-900">Note:</strong> These are informational fair-market bands, not offers to purchase. For a binding valuation, use the <a href="/valuation" class="text-signal-600 hover:underline">valuation tool</a>. Read the full <a href="/methodology" class="text-signal-600 hover:underline">methodology</a>.</p>
      </section>

      <!-- 9. FAQ -->
      <section aria-labelledby="faq-heading" class="mb-12">
        <h2 id="faq-heading" class="text-2xl font-serif text-navy-900 mb-4">Frequently asked questions</h2>
        <div class="space-y-4">
          {data.faq.map((item: any) => (
            <details class="card-institutional bg-white">
              <summary class="cursor-pointer font-semibold text-navy-900 text-base">{item.q}</summary>
              <p class="mt-3 text-base text-graphite leading-relaxed">{item.a}</p>
            </details>
          ))}
        </div>
      </section>

      <!-- 10. CTA -->
      <div class="card-institutional bg-navy-950 text-cream mb-12">
        <h2 class="font-serif text-2xl text-white mb-2">Get a personalised valuation for your {data.model}</h2>
        <p class="text-sm text-cream-200 mb-4">Enter your exact year, kilometres, variant and city for a price band tailored to your specific vehicle.</p>
        <a href="/valuation" class="inline-flex items-center px-6 py-3 bg-white text-navy-900 text-sm font-medium rounded-md hover:bg-cream-100 no-underline hover:no-underline transition-colors">
          Value my {data.model} →
        </a>
      </div>

      <!-- 11. Related models -->
      {data.relatedModels?.length > 0 && (
        <section aria-labelledby="rel-heading" class="mb-4">
          <h2 id="rel-heading" class="text-2xl font-serif text-navy-900 mb-4">Related models in this segment</h2>
          <div class="grid md:grid-cols-3 gap-4">
            {data.relatedModels.map((r: any) => (
              <a href={`/models/${r.make}/${r.model}`} class="card-institutional bg-white hover:border-signal-600 transition-colors no-underline">
                <div class="text-xs uppercase tracking-widest text-slate-soft mb-1">Same segment</div>
                <div class="font-serif text-navy-900 text-lg">{r.label} resale value</div>
              </a>
            ))}
          </div>
        </section>
      )}

    </div>
  </article>

  <!-- Client-side calculator: pure lookup from static JSON, zero API -->
  <script type="application/json" id="perm-data" set:html={JSON.stringify(data.permutations)}></script>
  <script is:inline>
    (function () {
      const perms = JSON.parse(document.getElementById('perm-data').textContent);
      const $ = (id) => document.getElementById(id);
      const yearEl = $('calc-year');
      const kmEl = $('calc-km');
      const fuelEl = $('calc-fuel');
      const cityEl = $('calc-city');
      const midEl = $('calc-mid');
      const bandEl = $('calc-band');
      const noteEl = $('calc-note');

      function update() {
        const year = parseInt(yearEl.value, 10);
        const km = kmEl.value;
        const fuel = fuelEl.value;
        const cityPct = parseFloat(cityEl.value) || 0;
        const match = perms.find(p => p.year === year && p.kmBand === km && p.fuel === fuel);
        if (!match) {
          midEl.textContent = '—';
          bandEl.textContent = 'No data for this combination';
          return;
        }
        const factor = 1 + cityPct / 100;
        const mid = (match.mid * factor).toFixed(2);
        const low = (match.low * factor).toFixed(2);
        const high = (match.high * factor).toFixed(2);
        midEl.textContent = `₹${mid}L`;
        bandEl.textContent = `Band: ₹${low}L – ₹${high}L`;
        const cityLabel = cityEl.options[cityEl.selectedIndex].text;
        noteEl.textContent = cityPct === 0
          ? 'All-India baseline. Select a city for a city-adjusted range.'
          : `Adjusted for ${cityLabel.split(' (')[0]} (${cityPct >= 0 ? '+' : ''}${cityPct}%).`;
      }

      [yearEl, kmEl, fuelEl, cityEl].forEach(el => el.addEventListener('change', update));
      update();
    })();
  </script>
</BaseLayout>
